[Unit]
Description=言 葉 (Kotoba) message board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kotoba
Group=kotoba
WorkingDirectory=/opt/kotoba/current
EnvironmentFile=/opt/kotoba/config/kotoba.env
ExecStart=/usr/local/bin/bun run src/start.ts
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/kotoba/shared/data /opt/kotoba/shared/uploads
InaccessiblePaths=/opt/kotoba/backups

[Install]
WantedBy=multi-user.target
