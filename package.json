{
  "name": "my-app",
  "version": "2.1.2",
  "packageManager": "bun@1.3.11",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/start.ts",
    "check": "bun test",
    "typecheck": "tsc --noEmit",
    "lint:client": "bun run --cwd client lint",
    "build:client": "bun run --cwd client build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "drizzle-kit": "^0.30",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "shell-quote": "1.10.0"
  }
}
