# Environment variables for 言 葉 (Kotoba)

# Secret for signing session cookies (REQUIRED for production)
# Use any random string — e.g. `openssl rand -hex 32`
COOKIE_SECRET=dev-secret-change-me

# Cloudflare Turnstile secret key for CAPTCHA
# Leave as-is for development (test key always passes)
# Get your own at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Cloudflare Turnstile site key for the React client.
# Vite reads this root .env via client/vite.config.ts envDir.
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA

# Persistent production data paths. Leave defaults for local development.
DB_PATH=sqlite.db
UPLOAD_DIR=uploads
